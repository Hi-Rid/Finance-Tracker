# =====================================================
# Synmony — Environment Variables
# =====================================================
# Copy file ini ke .env.local dan isi nilainya.
#
# Generate CRON_SECRET:  openssl rand -hex 32
# =====================================================

# ============ SUPABASE (WAJIB) ============
# Ambil dari Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============ AI (OPSIONAL) ============
# Untuk fitur AI Auto-Budgeting & Financial Advisor
# Ambil dari https://console.groq.com/keys
GROQ_API_KEY=

# ============ OCR (OPSIONAL) ============
# Untuk fitur scan struk
# Ambil dari https://app.nanonets.com
NANONETS_API_KEY=

# ============ CRON (WAJIB untuk Vercel Cron) ============
# Set di Vercel sebagai env var, Vercel otomatis kirim sebagai Bearer
# Generate: openssl rand -hex 32
CRON_SECRET=